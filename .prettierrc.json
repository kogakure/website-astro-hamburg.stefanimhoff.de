{
	"endOfLine": "lf",
	"plugins": ["prettier-plugin-astro", "prettier-plugin-tailwindcss"],
	"printWidth": 100,
	"semi": true,
	"overrides": [
		{
			"files": "*.astro",
			"options": {
				"parser": "astro"
			}
		}
	],
	"singleQuote": true,
	"trailingComma": "all",
	"useTabs": true,
	"tabWidth": 4
}
