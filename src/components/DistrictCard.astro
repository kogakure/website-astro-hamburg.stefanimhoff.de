---
import type { District } from '@/lib/districts.ts';
import { districtHero, districtThumbnail, formatDuration } from '@/lib/districts.ts';

export interface Props {
	district: District;
	index: number;
}

const { district, index } = Astro.props;
const tube = ['red', 'blue', 'white'][index % 3];
---

<li class="district-card">
	<a
		href={`/${district.id}/`}
		class={`tube-${tube}`}
		data-backdrop={districtHero(district)}
		data-umami-event={`District ${district.data.title}`}
	>
		<span class="district-name">{district.data.title}</span>
		<span class="district-log">
			{district.data.distanceKm} km · {formatDuration(district.data.durationMinutes)}
		</span>
		<img
			src={districtThumbnail(district)}
			alt={`A view from the ${district.data.title} walk`}
			width="450"
			height="338"
			loading="lazy"
			decoding="async"
		/>
	</a>
</li>

<style>
	.district-card {
		list-style: none;
		border-bottom: 1px solid color-mix(in oklch, var(--color-glass) 60%, transparent);
	}

	.district-card a {
		--tube: var(--tube-red);
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: baseline;
		gap: 0.25rem 1.5rem;
		padding-block: 0.35rem;
		color: var(--color-ink);
		text-decoration: none;
	}

	.district-card a.tube-blue {
		--tube: var(--tube-blue);
	}

	.district-card a.tube-white {
		--tube: var(--tube-white);
	}

	/* Unlit glass until pointed at, focused, or crossing the centre on touch screens. */
	.district-name {
		color: var(--color-unlit);
		color: oklch(from var(--tube) var(--unlit-l) 0.03 h);
		font-family: var(--font-neon);
		font-size: clamp(2.4rem, 7vw, 5.6rem);
		line-height: 1.1;
		transition:
			color 120ms steps(2, end),
			text-shadow 120ms steps(2, end);
	}

	.district-card a:hover .district-name,
	.district-card a:focus-visible .district-name,
	.district-card a.is-lit .district-name {
		color: var(--tube);
	}

	:global([data-theme='dark']) .district-card a:hover .district-name,
	:global([data-theme='dark']) .district-card a:focus-visible .district-name,
	:global([data-theme='dark']) .district-card a.is-lit .district-name {
		color: oklch(from var(--tube) calc(l + 0.2) calc(c * 0.5) h);
		text-shadow:
			0 0 0.04em var(--tube),
			0 0 0.18em var(--tube),
			0 0 0.6em oklch(from var(--tube) l c h / 0.55),
			0 0 1.4em oklch(from var(--tube) l c h / 0.35);
	}

	.district-log {
		color: var(--color-muted);
		font-size: var(--text-meta);
		font-weight: 500;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.district-card a:hover .district-log,
	.district-card a:focus-visible .district-log {
		color: var(--color-ink);
	}

	/* Pointer screens show the photo in the atlas window instead. */
	.district-card img {
		display: none;
	}

	@media (hover: none), (max-width: 56rem) {
		.district-card a {
			grid-template-columns: minmax(0, 1fr) 5.5rem;
			grid-template-rows: auto auto;
			align-items: center;
			padding-block: 0.75rem;
		}

		.district-name {
			font-size: clamp(2rem, 9vw, 3.4rem);
		}

		.district-log {
			grid-row: 2;
			white-space: normal;
		}

		.district-card img {
			display: block;
			grid-row: 1 / 3;
			grid-column: 2;
			width: 100%;
			aspect-ratio: 4 / 3;
			object-fit: cover;
		}
	}
</style>
