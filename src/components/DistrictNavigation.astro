---
import type { District } from '@/lib/districts.ts';

export interface Props {
	previous: District | null;
	next: District | null;
}

const { previous, next } = Astro.props;
---

<nav class="district-navigation" aria-label="District walks">
	{
		previous ? (
			<a class="previous" href={`/${previous.id}/`} rel="prev">
				<span>Previous walk</span>
				<strong>{previous.data.title}</strong>
			</a>
		) : (
			<span aria-hidden="true" />
		)
	}
	{
		next && (
			<a class="next" href={`/${next.id}/`} rel="next">
				<span>Next walk</span>
				<strong>{next.data.title}</strong>
			</a>
		)
	}
</nav>

<style>
	.district-navigation {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(1rem, 4vw, 3rem);
		margin-top: clamp(3rem, 7vw, 5rem);
	}

	.district-navigation a {
		display: flex;
		min-height: 4.5rem;
		flex-direction: column;
		justify-content: center;
		color: var(--color-ink);
		text-decoration: none;
	}

	.district-navigation span {
		color: var(--color-muted);
		font-size: var(--text-meta);
	}

	.district-navigation strong {
		--tube: var(--tube-white);
		color: var(--color-unlit);
		color: oklch(from var(--tube) var(--unlit-l) 0.03 h);
		font-family: var(--font-neon);
		font-size: clamp(1.8rem, 4.5vw, 3.4rem);
		font-weight: 400;
		line-height: 1.1;
		transition:
			color 120ms steps(2, end),
			text-shadow 120ms steps(2, end);
	}

	.district-navigation a:hover strong,
	.district-navigation a:focus-visible strong {
		color: var(--tube);
	}

	:global([data-theme='dark']) .district-navigation a:hover strong,
	:global([data-theme='dark']) .district-navigation a:focus-visible strong {
		color: oklch(from var(--tube) calc(l + 0.05) calc(c * 0.5) h);
		text-shadow:
			0 0 0.18em var(--tube),
			0 0 0.6em oklch(from var(--tube) l c h / 0.5);
	}

	.district-navigation .next {
		text-align: right;
	}

	@media (max-width: 34rem) {
		.district-navigation {
			grid-template-columns: 1fr;
		}

		.district-navigation .next {
			text-align: left;
		}
	}
</style>
