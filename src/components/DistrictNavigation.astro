---
import type { District } from '@/lib/districts.ts';

export interface Props {
	previous: District | null;
	next: District | null;
}

const { previous, next } = Astro.props;
---

<nav class="district-navigation" aria-label="District walks">
	{
		previous ? (
			<a class="previous" href={`/${previous.id}/`} rel="prev">
				<span>Previous walk</span>
				<strong>← {previous.data.title}</strong>
			</a>
		) : (
			<span aria-hidden="true" />
		)
	}
	{
		next && (
			<a class="next" href={`/${next.id}/`} rel="next">
				<span>Next walk</span>
				<strong>{next.data.title} →</strong>
			</a>
		)
	}
</nav>

<style>
	.district-navigation {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(1rem, 4vw, 3rem);
		margin-top: clamp(4rem, 10vw, 8rem);
		padding-top: 1.25rem;
		border-top: 1px solid var(--color-rule);
	}

	.district-navigation a {
		display: flex;
		min-height: 4.5rem;
		flex-direction: column;
		justify-content: center;
		color: var(--color-ink);
		text-decoration: none;
	}

	.district-navigation a:hover strong {
		color: var(--color-tide);
	}

	.district-navigation span {
		color: var(--color-muted);
		font-size: 0.8rem;
	}

	.district-navigation strong {
		font-size: clamp(1.1rem, 2.5vw, 1.6rem);
		font-weight: 620;
		font-variation-settings: 'wght' 620;
	}

	.district-navigation .next {
		text-align: right;
	}

	@media (max-width: 34rem) {
		.district-navigation {
			grid-template-columns: 1fr;
		}

		.district-navigation .next {
			text-align: left;
		}
	}
</style>
