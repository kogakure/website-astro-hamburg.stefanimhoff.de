---
import { site } from '@/data/site.ts';
---

<footer class="site-footer">
	<div>
		<p class="footer-title">Exploring Hamburg</p>
		<p>One city, recorded on foot.</p>
	</div>
	<div class="footer-meta">
		<a href="/imprint/">Imprint</a>
		<p>&copy; {new Date().getFullYear()} {site.author}</p>
	</div>
</footer>

<style>
	.site-footer {
		display: grid;
		max-width: var(--shell-width);
		grid-template-columns: 1fr auto;
		justify-content: space-between;
		gap: 2rem;
		margin-inline: auto;
		padding: 2rem var(--page-gutter) 3rem;
		border-top: 1px solid var(--color-rule);
		color: var(--color-muted);
		font-size: var(--text-secondary);
	}

	.site-footer p {
		margin: 0;
	}

	.footer-title {
		color: var(--color-ink);
		font-weight: 650;
	}

	.footer-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: flex-end;
		gap: 0.5rem 1.5rem;
		text-align: right;
	}

	.footer-meta a {
		display: inline-flex;
		min-height: 2.75rem;
		align-items: center;
	}

	@media (max-width: 35rem) {
		.site-footer {
			grid-template-columns: 1fr;
		}

		.footer-meta {
			justify-content: flex-start;
			text-align: left;
		}
	}
</style>
