---
import { site } from '@/data/site.ts';

import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header">
	<a class="site-identity" href="/" data-umami-event="Homepage">
		<span class="site-title">{site.title}</span>
		<span class="site-tagline">Street by Street, District by District.</span>
	</a>
	<ThemeToggle />
</header>

<style>
	.site-header {
		position: relative;
		z-index: 2;
		display: flex;
		max-width: var(--shell-width);
		min-height: 4.5rem;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-inline: auto;
		padding: 0.75rem var(--page-gutter);
	}

	.site-identity {
		display: flex;
		min-height: 2.75rem;
		align-items: baseline;
		gap: clamp(0.75rem, 2vw, 1.5rem);
		color: var(--color-ink);
		text-decoration: none;
	}

	.site-title {
		font-size: 1.05rem;
		font-weight: 750;
		letter-spacing: -0.01em;
	}

	.site-tagline {
		color: var(--color-muted);
		font-size: var(--text-caption);
	}

	.site-identity:hover .site-title {
		color: var(--tube-red);
	}

	@media (max-width: 34rem) {
		.site-tagline {
			display: none;
		}
	}
</style>
