---
import '@/styles/global.css';

import PageFooter from '@/components/PageFooter.astro';
import PageHeader from '@/components/PageHeader.astro';
import ThemeProvider from '@/components/ThemeProvider.astro';
import { site as siteConfig } from '@/data/site.ts';
import { serializeJsonLd } from '@/lib/json-ld.ts';

export interface Props {
	title: string;
	description: string;
	canonicalPath?: string;
	ogType?: 'website' | 'article';
	image?: string;
	robots?: string;
	publishedTime?: Date;
	structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
	title,
	description,
	canonicalPath,
	ogType = 'website',
	image = '/assets/images/branding/og/banner.png',
	robots,
	publishedTime,
	structuredData,
} = Astro.props;
const canonicalUrl = canonicalPath ? new URL(canonicalPath, Astro.site) : undefined;
const socialImage = new URL(image, Astro.site);
const serviceWorkerRegistration = `
	if ('serviceWorker' in navigator) {
		navigator.serviceWorker.register('/sw.js').catch(function (error) {
			console.warn('Service worker registration failed:', error);
		});
	}
`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="author" content={siteConfig.author} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f1f1f5" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#06070f" media="(prefers-color-scheme: dark)" />
		{robots && <meta name="robots" content={robots} />}
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
		<meta property="og:site_name" content={siteConfig.title} />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="675" />
		{
			publishedTime && (
				<meta property="article:published_time" content={publishedTime.toISOString()} />
			)
		}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImage} />
		<link
			rel="alternate"
			type="application/atom+xml"
			title="District walks"
			href="/index.xml"
		/>
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/assets/images/branding/favicons/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/assets/images/branding/favicons/apple-touch-icon.png" />
		<link
			rel="preload"
			href="/assets/fonts/schibsted-grotesk-vf.woff2"
			as="font"
			type="font/woff2"
			crossorigin="anonymous"
		/>
		<link
			rel="preload"
			href="/assets/fonts/tilt-neon.woff2"
			as="font"
			type="font/woff2"
			crossorigin="anonymous"
		/>
		{
			structuredData && (
				<script
					is:inline
					type="application/ld+json"
					set:html={serializeJsonLd(structuredData)}
				/>
			)
		}
		<title>{title}</title>
		<ThemeProvider />
		{
			import.meta.env.PROD && (
				<script
					is:inline
					defer
					src={siteConfig.analytics.endpoint}
					data-website-id={siteConfig.analytics.websiteId}
				/>
			)
		}
		{import.meta.env.PROD && <script is:inline set:html={serviceWorkerRegistration} />}
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<PageHeader />
		<slot />
		<PageFooter />
	</body>
</html>

<style>
	.skip-link {
		position: fixed;
		z-index: 100;
		top: 1rem;
		left: 1rem;
		translate: 0 -200%;
		min-height: 2.75rem;
		display: inline-flex;
		align-items: center;
		background: var(--color-ink);
		color: var(--color-wall);
		font-weight: 700;
		text-decoration: none;
		border: 1px solid var(--color-wall);
		padding: 0.75rem 1rem;
	}

	.skip-link:focus {
		translate: 0;
	}
</style>
