---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
	title="Error 404 · Exploring Hamburg"
	description="The requested page could not be found."
	robots="noindex,follow"
>
	<main id="main" class="not-found">
		<div class="error-copy">
			<div class="error-bearing" aria-hidden="true">404 / position unknown</div>
			<h1>Error 404</h1>
			<p class="error-message">
				So’n Schiet.<sup><a href="#schiet" aria-describedby="footnote-label">1</a></sup> This
				Page Can’t Be Found.
			</p>
			<p>Go back to the <a href="/">Homepage</a>.</p>
			<footer id="schiet" class="error-footnote">
				<span id="footnote-label" class="sr-only">Footnote</span><p>
					<sup>1</sup> “such a crap” (Hamburg Dialect)
				</p>
			</footer>
		</div>
		<div class="error-plot" aria-hidden="true">
			<span>53° 33′ N</span>
			<span class="bearing-mark"></span>
			<span>009° 59′ E</span>
		</div>
	</main>
</BaseLayout>

<style>
	.not-found {
		max-width: 66rem;
		min-height: min(72vh, 48rem);
		margin-inline: auto;
		padding: clamp(4rem, 10vw, 9rem) var(--page-gutter);
	}
	.error-plot {
		display: none;
	}
	.error-bearing {
		margin-bottom: clamp(2rem, 6vw, 5rem);
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--color-rule);
		color: var(--color-buoy);
		font-size: var(--text-caption);
		font-variant-numeric: tabular-nums;
	}
	h1 {
		font-size: clamp(3.5rem, 12vw, 6rem);
	}
	.error-message {
		max-width: 28ch;
		margin-block: 1.5rem;
		font-size: clamp(1.4rem, 3vw, 2.3rem);
		line-height: 1.25;
	}
	.error-copy > p a {
		text-decoration-line: underline;
		text-decoration-thickness: 0.08em;
		text-underline-offset: 0.2em;
	}
	.error-message sup a {
		display: inline-flex;
		min-width: 1.5rem;
		min-height: 1.5rem;
		align-items: center;
		justify-content: center;
		font-size: 0.55em;
	}
	.error-footnote {
		max-width: 32rem;
		margin-top: clamp(4rem, 10vw, 8rem);
		padding-top: 1rem;
		border-top: 1px solid var(--color-rule);
		color: var(--color-muted);
		font-size: var(--text-secondary);
	}
	.error-footnote p {
		margin: 0;
	}
	@media (min-width: 48rem) {
		.not-found {
			display: grid;
			grid-template-columns: minmax(0, 1.15fr) minmax(12rem, 0.85fr);
			gap: clamp(4rem, 10vw, 9rem);
		}
		.error-plot {
			display: grid;
			grid-template-columns: auto minmax(4rem, 1fr) auto;
			align-self: center;
			align-items: center;
			gap: 0.75rem;
			color: var(--color-muted);
			font-size: var(--text-caption);
			font-variant-numeric: tabular-nums;
		}
		.bearing-mark {
			position: relative;
			height: 1px;
			background: var(--color-rule);
		}
		.bearing-mark::after {
			position: absolute;
			top: 50%;
			left: 50%;
			width: 0.75rem;
			height: 0.75rem;
			translate: -50% -50%;
			border: 1px solid var(--color-buoy);
			border-radius: 50%;
			background: var(--color-canvas);
			content: '';
		}
	}
</style>
