---
import { getCollection, render, type CollectionEntry } from 'astro:content';

import ContentImage from '@/components/ContentImage.astro';
import ContentLink from '@/components/ContentLink.astro';
import DistrictNavigation from '@/components/DistrictNavigation.astro';
import MapEmbed from '@/components/MapEmbed.astro';
import YouTubeEmbed from '@/components/YouTubeEmbed.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
	districtHero,
	districtNavigation,
	formatDuration,
	sortDistricts,
} from '@/lib/districts.ts';

export async function getStaticPaths() {
	const districts = await getCollection('districts');
	return districts.map((district) => ({
		params: { slug: district.id },
		props: { district, districts },
	}));
}

interface Props {
	district: CollectionEntry<'districts'>;
	districts: CollectionEntry<'districts'>[];
}

const { district, districts } = Astro.props;
const { Content } = await render(district);
const { previous, next } = districtNavigation(districts, district.id);
const sortedDistricts = sortDistricts(districts);
const walkIndex = sortedDistricts.findIndex((item) => item.id === district.id) + 1;
const titleLength = district.data.title.length;
const titleSize = titleLength >= 14 ? 'extra-long' : titleLength >= 11 ? 'long' : 'regular';
const canonicalPath = `/${district.id}/`;
const image = districtHero(district);
const description = `Photographs, a map, and walking notes from exploring ${district.data.title} in Hamburg.`;
const pageUrl = new URL(canonicalPath, Astro.site);
const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'Article',
		headline: district.data.title,
		datePublished: district.data.date.toISOString(),
		author: { '@type': 'Person', name: district.data.author },
		image: new URL(image, Astro.site),
		mainEntityOfPage: pageUrl,
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{
				'@type': 'ListItem',
				position: 1,
				name: 'Exploring Hamburg',
				item: new URL('/', Astro.site),
			},
			{ '@type': 'ListItem', position: 2, name: district.data.title, item: pageUrl },
		],
	},
];
const contentComponents = { img: ContentImage, a: ContentLink, MapEmbed, YouTubeEmbed };
---

<BaseLayout
	title={`${district.data.title} · Exploring Hamburg`}
	{description}
	{canonicalPath}
	ogType="article"
	{image}
	publishedTime={district.data.date}
	{structuredData}
>
	<main id="main" class="district-page">
		<nav class="breadcrumbs" aria-label="Breadcrumb">
			<a href="/">District atlas</a><span aria-hidden="true"> / </span><span
				aria-current="page">{district.data.title}</span
			>
		</nav>
		<header class="district-masthead">
			<div class="district-title">
				<p class="walk-position">
					Walk {String(walkIndex).padStart(2, '0')} of {districts.length}
				</p>
				<h1 class:list={[`district-heading--${titleSize}`]}>{district.data.title}</h1>
				<dl class="route-log">
					<div><dt>Distance</dt><dd>{district.data.distanceKm} km</dd></div>
					<div>
						<dt>Walking time</dt><dd>
							{formatDuration(district.data.durationMinutes)}
						</dd>
					</div>
					<div>
						<dt>Recorded</dt><dd>
							{
								district.data.date.toLocaleDateString('en-GB', {
									year: 'numeric',
									month: 'short',
								})
							}
						</dd>
					</div>
				</dl>
			</div>
			<img
				class="district-hero"
				src={image}
				alt={`Street-level view from the ${district.data.title} walk`}
				fetchpriority="high"
				decoding="async"
			/>
		</header>
		<div class="district-reading-grid">
			<div class="district-reading-column">
				<article class="district-content">
					<Content components={contentComponents} />
				</article>
				<nav class="gallery-recovery" aria-label="Walk page shortcuts">
					<a href="#main">Back to walk summary <span aria-hidden="true">↑</span></a>
					<a href="/">Return to district atlas</a>
				</nav>
				<DistrictNavigation {previous} {next} />
			</div>
		</div>
	</main>
</BaseLayout>

<style>
	.district-page {
		--district-columns: minmax(22rem, 0.9fr) minmax(0, 1.7fr);
		max-width: var(--shell-width);
		margin-inline: auto;
		padding: clamp(1.25rem, 3vw, 2rem) var(--page-gutter) clamp(5rem, 10vw, 9rem);
	}

	.breadcrumbs {
		margin-bottom: clamp(1.5rem, 4vw, 3rem);
		color: var(--color-muted);
		font-size: var(--text-meta);
	}

	.breadcrumbs a {
		min-height: 2.75rem;
		display: inline-flex;
		align-items: center;
		margin-block: -0.75rem;
	}

	.breadcrumbs span[aria-hidden] {
		margin-inline: 0.45rem;
	}

	.district-masthead {
		display: grid;
		width: calc(100% + var(--page-gutter) + var(--page-gutter));
		margin-inline: calc(-1 * var(--page-gutter));
		grid-template-columns: var(--district-columns);
		align-items: stretch;
		border-block: 1px solid var(--color-rule);
	}

	.district-hero {
		display: block;
		width: 100%;
		height: clamp(28rem, 58vw, 49rem);
		object-fit: cover;
		object-position: center;
	}

	.district-reading-grid {
		display: grid;
		width: calc(100% + var(--page-gutter) + var(--page-gutter));
		margin-inline: calc(-1 * var(--page-gutter));
		grid-template-columns: var(--district-columns);
		container-type: inline-size;
	}

	.district-reading-column {
		width: 100%;
		min-width: 0;
		grid-column: 2;
	}

	.district-content {
		width: 100%;
		max-width: none;
		margin-inline: 0;
	}

	.gallery-recovery,
	:global(.district-navigation) {
		width: min(100%, var(--reading-width));
		max-width: none;
		margin-inline: 0;
	}

	.gallery-recovery {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 2rem;
		margin-top: clamp(4rem, 8vw, 7rem);
		padding-block: 1rem;
		border-block: 1px solid var(--color-rule);
	}

	.gallery-recovery a {
		display: inline-flex;
		min-height: 2.75rem;
		align-items: center;
		gap: 0.35rem;
	}

	.district-title {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: clamp(2rem, 5vw, 4.5rem);
		background: var(--color-surface);
	}

	.walk-position {
		margin: 0;
		color: var(--color-buoy);
		font-size: var(--text-meta);
		font-variant-numeric: tabular-nums;
	}

	.district-title h1 {
		margin-block: auto;
		padding-block: clamp(3rem, 7vw, 7rem);
		font-size: clamp(3.2rem, 6.5vw, 5.5rem);
		overflow-wrap: normal;
		word-break: normal;
		hyphens: manual;
	}

	.district-title h1.district-heading--long {
		font-size: clamp(2.75rem, 5vw, 4.5rem);
	}

	.district-title h1.district-heading--extra-long {
		font-size: clamp(2.5rem, 4.2vw, 3.75rem);
	}

	.route-log {
		margin: 0;
		border-top: 1px solid var(--color-rule);
	}

	.route-log div {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 0.55rem;
		border-bottom: 1px solid var(--color-rule);
		font-size: var(--text-meta);
		font-variant-numeric: tabular-nums;
	}

	.route-log dt {
		color: var(--color-muted);
	}

	.route-log dd {
		margin: 0;
		text-align: right;
	}

	.district-content {
		margin-top: clamp(4rem, 9vw, 8rem);
		font-size: clamp(1.05rem, 1.2vw, 1.18rem);
		line-height: 1.75;
	}

	:global([data-theme='dark']) .district-content {
		letter-spacing: 0.01em;
		line-height: 1.8;
	}

	.district-content :global(p) {
		max-width: var(--reading-width);
		margin-block: 1.35em;
	}

	.district-content :global(:where(h2, h3, h4, ul, ol, blockquote, pre, table, .footnotes)) {
		max-width: var(--reading-width);
	}

	.district-content :global(a[target='_blank']::after) {
		content: ' ↗';
		font-size: 0.72em;
		text-decoration: none;
	}

	.district-content :global(img) {
		display: block;
		width: min(82rem, calc(100vw - 2 * var(--page-gutter)));
		max-width: none;
		height: auto;
		margin-block: clamp(2rem, 6vw, 5rem);
		margin-inline: 50%;
		transform: translateX(-50%);
		background: var(--color-surface);
	}

	.district-content :global(.embed) {
		width: min(70rem, calc(100vw - 2 * var(--page-gutter)));
		max-width: none;
		margin: clamp(3rem, 7vw, 6rem) 50%;
		transform: translateX(-50%);
		border-block: 1px solid var(--color-rule);
		padding-block: 1rem;
	}

	.district-content :global(.embed iframe) {
		display: block;
		width: 100%;
		border: 0;
		aspect-ratio: 16 / 9;
		background: var(--color-surface);
	}

	.district-content :global(.embed-map iframe) {
		min-height: min(34rem, 72vh);
	}

	.district-content :global(figcaption) {
		margin-top: 0.65rem;
		color: var(--color-muted);
		font-size: var(--text-meta);
	}

	.district-content :global(.footnotes) {
		margin-top: 4rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--color-rule);
		color: var(--color-muted);
		font-size: var(--text-secondary);
	}

	.district-content :global(sup a) {
		display: inline-flex;
		min-width: 1.5rem;
		min-height: 1.5rem;
		align-items: center;
		justify-content: center;
	}

	@media (min-width: 55.001rem) {
		.district-content :global(img),
		.district-content :global(.embed) {
			position: relative;
			left: calc(50cqw - max(22rem, 34.615cqw));
			margin-inline: 0;
			transform: translateX(-50%);
		}
	}

	@media (max-width: 55rem) {
		.district-page {
			--district-columns: 1fr;
		}

		.district-masthead {
			grid-template-columns: 1fr;
		}

		.district-reading-column {
			width: auto;
			margin-inline: var(--page-gutter);
			grid-column: 1;
		}

		.district-title {
			min-height: 25rem;
		}

		.district-hero {
			height: min(80vw, 38rem);
		}
	}

	@media (max-width: 30rem) {
		.district-title {
			min-height: 22rem;
			padding: 1.5rem;
		}
	}
</style>
