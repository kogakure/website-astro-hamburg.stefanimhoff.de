---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
	title="Exploring Hamburg"
	description="Walking through the districts of Hamburg, one route at a time."
	canonicalPath="/"
>
	<main id="main" class="mx-auto flex min-h-screen max-w-4xl items-center px-6 py-16">
		<div>
			<p class="mb-4 text-sm font-semibold tracking-[0.18em] uppercase">
				Astro migration baseline
			</p>
			<h1 class="max-w-3xl text-5xl leading-none font-semibold tracking-tight md:text-7xl">
				Exploring Hamburg
			</h1>
			<p class="mt-8 max-w-2xl text-xl leading-relaxed">
				The district walks are being prepared for their new field journal. Existing content
				remains untouched while the Astro foundation is established.
			</p>
		</div>
	</main>
</BaseLayout>
