---
import { getCollection } from 'astro:content';

import DistrictCard from '@/components/DistrictCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { districtHero, districtTotals, sortDistricts } from '@/lib/districts.ts';

const districts = sortDistricts(await getCollection('districts'));
const totals = districtTotals(districts);
const totalDistricts = 109;
const unwalked = totalDistricts - districts.length;
const description =
	'Walking through the districts of Hamburg: photographs, maps, and notes from exploring the city on foot.';
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'Exploring Hamburg',
	url: new URL('/', Astro.site),
	description,
};
---

<BaseLayout title="Exploring Hamburg" {description} canonicalPath="/" {structuredData}>
	<main id="main">
		<div class="opening">
			<section class="sign" aria-labelledby="homepage-title">
				<div class="sign-backdrop">
					<img
						sizes="100vw"
						srcset="/assets/images/core/homepage-hero-600.jpg 600w, /assets/images/core/homepage-hero-1200.jpg 1200w, /assets/images/core/homepage-hero.jpg 1800w"
						src="/assets/images/core/homepage-hero.jpg"
						alt="Red lightship and boats in Hamburg harbor"
						fetchpriority="high"
						decoding="async"
					/>
				</div>
				<h1 id="homepage-title" class="tube ignite">
					<span>Exploring</span>
					<span>Hamburg</span>
				</h1>
				<p class="motto tube tube--white">Street by Street, District by District.</p>
			</section>
			<div class="ledger">
				<section class="project-intro" aria-labelledby="about-title">
					<h2 id="about-title">A city learned on foot</h2>
					<div class="intro-copy">
						<p>
							After living in Hamburg for more than 10 years, and still only knowing a
							small part of the city, I decided in 2015 to explore every district
							completely.
						</p>
						<p>
							I travel with my camera and a map all 109 districts of Hamburg – as
							complete as possible, mostly by foot.
						</p>
					</div>
				</section>

				<section class="walk-record" aria-labelledby="statistics-title">
					<h2 id="statistics-title">Walk record</h2>
					<p>A running log of the published routes.</p>
					<dl class="meters">
						<div>
							<dt>Distance walked</dt>
							<dd>
								<strong class="tube tube--blue">{totals.distanceKm}</strong><span
									>km</span
								>
							</dd>
						</div>
						<div>
							<dt>Time on foot</dt>
							<dd>
								<strong class="tube tube--blue">{totals.durationHours}</strong><span
									>hours</span
								>
							</dd>
						</div>
						<div>
							<dt>District walks</dt>
							<dd>
								<strong class="tube tube--blue">{totals.count}</strong><span
									>of {totalDistricts}</span
								>
							</dd>
						</div>
					</dl>
				</section>
			</div>
		</div>

		<section class="districts" aria-labelledby="districts-title">
			<header class="districts-heading">
				<h2 id="districts-title">District atlas</h2>
				<p>
					{districts.length} published walks, ordered alphabetically.{' '}
					<span class="pointer-hint">Point at a name to switch it on.</span>
				</p>
			</header>
			<div class="atlas">
				<ol class="district-index">
					{districts.map((district, index) => <DistrictCard {district} {index} />)}
				</ol>
				<figure class="atlas-window" aria-hidden="true">
					<img
						src={districtHero(districts[0])}
						alt=""
						width="1280"
						height="960"
						loading="lazy"
						decoding="async"
					/>
					<figcaption class="tube tube--red">{districts[0].data.title}</figcaption>
				</figure>
			</div>

			<div class="unlit">
				<p>{unwalked} districts are still dark.</p>
				<ol aria-hidden="true">
					{Array.from({ length: unwalked }, () => <li />)}
				</ol>
			</div>
		</section>
	</main>
</BaseLayout>

<script>
	const windowImage = document.querySelector<HTMLImageElement>('.atlas-window img');
	const windowCaption = document.querySelector<HTMLElement>('.atlas-window figcaption');
	const links = [...document.querySelectorAll<HTMLAnchorElement>('.district-card > a')];
	const tubes = ['tube-red', 'tube-blue', 'tube-white'];

	function light(link: HTMLAnchorElement) {
		if (!windowImage || !windowCaption) return;
		const source = link.dataset.backdrop;
		if (!source || windowImage.getAttribute('src') === source) return;
		const tube = tubes.find((name) => link.classList.contains(name)) ?? 'tube-red';
		const next = new Image();
		next.src = source;
		next.decode().then(
			() => {
				windowImage.src = source;
				windowCaption.textContent = link.querySelector('.district-name')?.textContent ?? '';
				windowCaption.className = `tube tube--${tube.slice(5)}`;
				windowImage.parentElement?.style.setProperty('--tube', `var(--${tube})`);
			},
			() => undefined,
		);
	}

	for (const link of links) {
		link.addEventListener('pointerenter', () => light(link));
		link.addEventListener('focus', () => light(link));
	}

	// Touch screens have no hover: the name crossing the middle of the screen lights up.
	if (matchMedia('(hover: none)').matches) {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					entry.target.classList.toggle('is-lit', entry.isIntersecting);
				}
			},
			{ rootMargin: '-49% 0px -49% 0px' },
		);
		links.forEach((link) => observer.observe(link));
	}
</script>

<style>
	main {
		position: relative;
		max-width: var(--shell-width);
		margin-inline: auto;
		padding: 0 var(--page-gutter) clamp(5rem, 10vw, 9rem);
	}

	/*
	 * First viewport: the sign on the harbour photo, then intro and meters on
	 * the bare wall. Only the large lit sign ever sits on the photograph.
	 */
	.opening {
		display: flex;
		min-height: calc(100svh - 4.5rem);
		flex-direction: column;
	}

	.sign {
		position: relative;
		isolation: isolate;
		display: grid;
		flex: 1;
		align-content: end;
		padding-block: clamp(2.5rem, 6vw, 5rem) clamp(2rem, 4vw, 3rem);
	}

	h1 {
		display: flex;
		flex-wrap: wrap;
		gap: 0 0.26em;
		font-size: clamp(4.6rem, 11.5vw, 10.5rem);
		line-height: 0.95;
		letter-spacing: 0;
	}

	.motto {
		margin: 0.75rem 0 0;
		font-size: clamp(1.4rem, 3vw, 2.4rem);
		line-height: 1.2;
	}

	.sign-backdrop {
		position: absolute;
		inset: -4.5rem calc(50% - 50vw) 0;
		z-index: -1;
		overflow: hidden;
	}

	/* Stronger veil under the header, lighter behind the sign, solid wall at the foot. */
	.sign-backdrop::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(
			to bottom,
			color-mix(in oklch, var(--color-wall) 85%, transparent) 0,
			color-mix(in oklch, var(--color-wall) 66%, transparent) 5rem,
			color-mix(in oklch, var(--color-wall) 70%, transparent) 70%,
			var(--color-wall)
		);
	}

	:global([data-theme='dark']) .sign-backdrop::after {
		background: linear-gradient(
			to bottom,
			color-mix(in oklch, var(--color-wall) 80%, transparent) 0,
			color-mix(in oklch, var(--color-wall) 30%, transparent) 5rem,
			color-mix(in oklch, var(--color-wall) 45%, transparent) 70%,
			var(--color-wall)
		);
	}

	.sign-backdrop img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 40%;
		filter: saturate(0.75);
	}

	:global([data-theme='dark']) .sign-backdrop img {
		filter: brightness(0.5) saturate(0.85);
	}

	.ledger {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
		gap: 2rem clamp(2.5rem, 6vw, 6rem);
		padding-block: 0 clamp(3rem, 6vw, 5rem);
	}

	h2 {
		font-size: clamp(1.25rem, 2vw, 1.5rem);
	}

	.intro-copy {
		max-width: 54ch;
		margin-top: 0.9rem;
		color: var(--color-ink);
	}

	.intro-copy p {
		margin: 0 0 1rem;
	}

	.walk-record > p {
		margin: 0.4rem 0 0.75rem;
		color: var(--color-muted);
	}

	.meters {
		margin: 0;
	}

	.meters div {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		padding-block: 0.6rem;
		border-bottom: 1px solid var(--color-glass);
	}

	.meters dt {
		color: var(--color-muted);
		font-weight: 500;
	}

	.meters dd {
		display: flex;
		align-items: baseline;
		gap: 0.4rem;
		margin: 0;
	}

	.meters strong {
		font-size: clamp(2.2rem, 4vw, 3.2rem);
		line-height: 1;
		font-variant-numeric: tabular-nums;
	}

	.meters dd span {
		color: var(--color-muted);
		font-size: var(--text-meta);
	}

	/* The header repeats the sign here; let the sign carry the name. */
	:global(.site-tagline) {
		display: none;
	}

	/* District atlas: a wall of tube names. */
	.districts {
		padding-top: clamp(3rem, 7vw, 5.5rem);
		border-top: 1px solid var(--color-glass);
	}

	.districts-heading p {
		margin: 0.5rem 0 clamp(1.5rem, 4vw, 2.5rem);
		color: var(--color-muted);
	}

	.atlas {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: clamp(2rem, 4vw, 4rem);
		align-items: start;
	}

	.district-index {
		margin: 0;
		padding: 0;
	}

	.atlas-window {
		display: none;
	}

	/* Pointer screens: the lit name drives a photo window that stays in view. */
	@media (hover: hover) and (min-width: 56.0625rem) {
		.atlas {
			grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
		}

		.atlas-window {
			position: sticky;
			top: 2rem;
			display: block;
			margin: 0;
		}

		.atlas-window img {
			display: block;
			width: 100%;
			height: auto;
			aspect-ratio: 4 / 5;
			object-fit: cover;
		}

		.atlas-window {
			--tube: var(--tube-red);
		}

		:global([data-theme='dark']) .atlas-window img {
			box-shadow:
				0 0 0 1px oklch(from var(--tube) l c h / 0.6),
				0 0 3rem oklch(from var(--tube) l c h / 0.28),
				0 30px 60px -30px oklch(0% 0 0 / 0.85);
			transition: box-shadow 200ms steps(2, end);
		}

		.atlas-window figcaption {
			margin-top: 0.75rem;
			font-size: clamp(1.6rem, 2.6vw, 2.4rem);
			line-height: 1.1;
		}
	}

	@media (hover: none) {
		.pointer-hint {
			display: none;
		}
	}

	.unlit {
		margin-top: clamp(3rem, 6vw, 5rem);
	}

	.unlit p {
		margin: 0 0 1rem;
		color: var(--color-muted);
	}

	.unlit ol {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.unlit li {
		width: 2.6rem;
		height: 0.55rem;
		border: 1.5px solid var(--color-unlit);
		border-radius: 1rem;
	}

	@media (max-width: 56rem) {
		.ledger {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
