{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"]
		},
		"types": ["vitest/globals", "vitest-axe/extend-expect"]
	},
	"include": [".astro/types.d.ts", "src/**/*", "tests/**/*", "*.config.*"],
	"exclude": [
		".eleventy.js",
		"gulpfile.js",
		"plopfile.js",
		"postcss.config.js",
		"src/**/*.js",
		"workbox.config.js"
	]
}
